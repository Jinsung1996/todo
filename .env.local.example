# MongoDB connection string. If unset, the app falls back to an in-memory
# MongoDB instance (mongodb-memory-server) for local development only.
MONGODB_URI=mongodb://localhost:27017/todo

# GitHub OAuth App credentials. See docs/LOGIN_SETUP.md for how to create the
# OAuth App and fill these in. Never commit real values — this file is only
# a template (actual secrets go in .env.local, which is gitignored).
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Optional: your app's public base URL (no trailing slash), used to build the
# GitHub OAuth redirect_uri. Leave unset for local dev (inferred automatically
# as http://localhost:3000). Set this explicitly on Vercel/production to avoid
# any proxy-related protocol/host mismatch with what's registered on GitHub.
# APP_URL=https://your-app.vercel.app
